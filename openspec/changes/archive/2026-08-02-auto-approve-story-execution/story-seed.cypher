// Story graph seed for change
// change: "auto-approve-story-execution"
// project: "github.com/aplacaba/agent-skills"
// Idempotent: each statement uses MERGE; safe to re-run.
MERGE (p:Project {name: "github.com/aplacaba/agent-skills"});
MERGE (c:Change {name: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"});
MATCH (p:Project {name: "github.com/aplacaba/agent-skills"}),
      (c:Change {name: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MERGE (p)-[:BELONGS_TO]->(c);

MERGE (s:Story {id: "command-auto-flag", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
ON CREATE SET s.title = "Add --auto flag to opsx-story command", s.description = "WHAT: Update commands/opsx-story.md so the story command documents the opt-in `--auto` flag per design D2. All three edits are prose-level.\nFILES:\n  - modify: commands/opsx-story.md\nEDGE CASES:\n  - input line wording exactly: \"Optionally pass `--auto` to run the loop without pausing for confirmation between stories (interactive confirmation remains the default)\"\n  - Loop step: \"if `--auto` was passed, continue without pausing; otherwise confirm with the user, repeat\"\n  - guardrail: \"Keep going through stories until done or blocked; confirmation between stories applies in interactive mode only (`--auto` skips it)\"\n  - no other text in the command is altered\nCONTEXT: design.md D2 command edits; proposal.md (auto changes ONLY inter-story confirmation).", s.acceptanceCriteria = ["commands/opsx-story.md input line documents --auto with interactive-as-default wording", "the Loop step branches on --auto (continue without pausing) vs confirm-with-user", "the guardrail states confirmation applies in interactive mode only"], s.taskRefs = ["1.1 Add `--auto` to the command's input line: \"Optionally pass `--auto` to run the loop without pausing for confirmation between stories (interactive confirmation remains the default)\"", "1.2 Update the Loop step: \"if `--auto` was passed, continue without pausing; otherwise confirm with the user, repeat\"", "1.3 Update the guardrail: \"Keep going through stories until done or blocked; confirmation between stories applies in interactive mode only (`--auto` skips it)\""], s.status = "pending";
MATCH (c:Change {name: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"}),
      (s:Story {id: "command-auto-flag", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "skill-auto-flag", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
ON CREATE SET s.title = "Add --auto flag to the story-driver skill", s.description = "WHAT: Update skills/openspec-story-driver/SKILL.md so the skill documents the opt-in `--auto` flag per design D2. Three prose edits.\nFILES:\n  - modify: skills/openspec-story-driver/SKILL.md\nEDGE CASES:\n  - input line wording matches the command's (interactive remains default)\n  - Phase 3 step 8: \"If the run was started with `--auto`, skip the confirmation and continue to the next story automatically; all other stops (Phase 1 stories.md approval, ambiguity, MCP failure, blocked, complete) still apply\"\n  - Guardrails section gains a bullet: \"Confirmation between stories applies in interactive mode only; `--auto` skips it (the loop still stops on ambiguity, MCP failure, blocked runs, and completion)\"\n  - no other text in the skill is altered\nCONTEXT: design.md D2 skill edits; specs/story-execution/spec.md (flag-only activation, preserved stops).", s.acceptanceCriteria = ["SKILL.md input line documents --auto with interactive-as-default wording", "Phase 3 step 8 documents auto-skip with all other stops preserved", "Guardrails section contains the interactive-only confirmation bullet"], s.taskRefs = ["2.1 Add `--auto` to the skill's input line with the same wording as the command (interactive remains default)", "2.2 Update Phase 3 step 8: \"If the run was started with `--auto`, skip the confirmation and continue to the next story automatically; all other stops (Phase 1 stories.md approval, ambiguity, MCP failure, blocked, complete) still apply\"", "2.3 Add a guardrails bullet: \"Confirmation between stories applies in interactive mode only; `--auto` skips it (the loop still stops on ambiguity, MCP failure, blocked runs, and completion)\""], s.status = "pending";
MATCH (c:Change {name: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"}),
      (s:Story {id: "skill-auto-flag", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "verify-auto-wording", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
ON CREATE SET s.title = "Verify --auto documentation", s.description = "WHAT: Run the verification pass for the change: grep both files for --auto, confirm interactive behavior unchanged, confirm preserved stops.\nFILES:\n  - none (verification only; fix any failures in the file they originate from)\nEDGE CASES:\n  - grep commands/opsx-story.md and skills/openspec-story-driver/SKILL.md: --auto present in input line, loop/step text, and guardrails in both files\n  - interactive-mode wording unchanged except documented additions (no confirmation behavior removed)\n  - wording in both files preserves Phase 1 stories.md approval, ambiguity stops, MCP-unreachable stops, blocked runs, and completion under --auto\nCONTEXT: tasks group 3; design D2.", s.acceptanceCriteria = ["grep shows --auto in input line, loop/step text, and guardrails in both files", "interactive-mode text is unchanged except the documented additions", "preserved stops (stories.md approval, ambiguity, MCP, blocked, completion) are stated under --auto in both files"], s.taskRefs = ["3.1 Grep `commands/opsx-story.md` and `skills/openspec-story-driver/SKILL.md` for `--auto` — present in input line, loop/step text, and guardrails in both files", "3.2 Confirm interactive-mode wording is unchanged except the documented additions (no confirmation behavior removed)", "3.3 Confirm the wording in both files preserves Phase 1 stories.md approval, ambiguity stops, MCP-unreachable stops, blocked runs, and completion under `--auto`"], s.status = "pending";
MATCH (c:Change {name: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"}),
      (s:Story {id: "verify-auto-wording", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MERGE (c)-[:HAS_STORY]->(s);

MATCH (a:Story {id: "verify-auto-wording", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MATCH (b:Story {id: "command-auto-flag", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MERGE (a)-[:DEPENDS_ON]->(b);

MATCH (a:Story {id: "verify-auto-wording", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MATCH (b:Story {id: "skill-auto-flag", change: "auto-approve-story-execution", project: "github.com/aplacaba/agent-skills"})
MERGE (a)-[:DEPENDS_ON]->(b);