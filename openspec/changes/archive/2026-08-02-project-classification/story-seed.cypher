// Story graph seed for change
// change: "project-classification"
// Idempotent: each statement uses MERGE; safe to re-run.
MERGE (c:Change {name: "project-classification"});

MERGE (s:Story {id: "add-generate-project-flag", change: "project-classification"})
ON CREATE SET s.title = "Add required --project flag to generate", s.description = "WHAT: Extend scripts/story_driver.clj so the `generate` subcommand accepts a required `--project <name>` flag, per design D3 and the harness-adapters CLI contract.\nFILES:\n  - modify: scripts/story_driver.clj (parse-args generate spec, sub-usage, root-help)\nEDGE CASES:\n  - generate invoked without --project → usage + \"the following arguments are required: --project\" on stderr, exit 2\n  - --project as the last token (no value) → \"argument --project: expected one argument\", exit 2\n  - --project followed by another flag (e.g. --project --root x) → \"argument --project: expected one argument\", exit 2\n  - --project on parse-tasks/sync-tasks/append-state → \"unrecognized arguments: --project\", exit 2\nCONTEXT: design.md D3; specs/harness-adapters/spec.md CLI contract; existing parse-args structure in scripts/story_driver.clj (flags map, sub-usage map).", s.acceptanceCriteria = ["generate without --project exits 2 and prints 'the following arguments are required: --project' on stderr", "generate --project with no value or a flag as value exits 2 with 'argument --project: expected one argument' on stderr", "generate -h and root -h show required --project PROJECT; --project on other subcommands exits 2"], s.taskRefs = ["1.1 Add `--project <name>` to the `generate` subcommand spec in `parse-args`: required flag, allowed on generate only; missing flag → usage + `the following arguments are required: --project` on stderr, exit 2; missing value or flag-as-value → `argument --project: expected one argument`, exit 2", "1.4 Update `story_driver.clj` usage/help text (`generate` usage line gains required `--project PROJECT`; root help mentions the flag as required)"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "add-generate-project-flag", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "project-scoped-seed", change: "project-classification"})
ON CREATE SET s.title = "Emit project-scoped seed statements", s.description = "WHAT: Update scripts/story_driver.clj so `write-seed` threads the project through cmd-generate and emits project-scoped Cypher, per design D2/D3.\nFILES:\n  - modify: scripts/story_driver.clj (write-seed signature + body, cmd-generate)\nEDGE CASES:\n  - seed header comment gains a project line (e.g. \"// project: \\\"...\\\"\")\n  - Story nodes keep the existing `ON CREATE SET` property block unchanged (title/description/acceptanceCriteria/taskRefs/status)\n  - every HAS_STORY and DEPENDS_ON MATCH filters on all of id/change/project (or name/project for Change)\nCONTEXT: design.md D2/D3 exact statement forms; current write-seed in scripts/story_driver.clj.\nEmit exactly:\n  MERGE (p:Project {name: <project>});\n  MERGE (c:Change {name: <change>, project: <project>});\n  MATCH (p:Project {name: <project>}), (c:Change {name: <change>, project: <project>})\n  MERGE (p)-[:BELONGS_TO]->(c);\n  MERGE (s:Story {id: <id>, change: <change>, project: <project>})\n  ON CREATE SET s.title = ..., s.description = ..., s.acceptanceCriteria = ..., s.taskRefs = ..., s.status = \"pending\";\n  MATCH (c:Change {name: <change>, project: <project>}), (s:Story {id: <id>, change: <change>, project: <project>})\n  MERGE (c)-[:HAS_STORY]->(s);\n  // DEPENDS_ON edges with three-property MATCHes", s.acceptanceCriteria = ["generate --project emits MERGE (p:Project {name: ...}) and MERGE (c:Change {name: ..., project: ...}) plus the literal BELONGS_TO MATCH/MERGE pair", "Story nodes merge as {id, change, project} with ON CREATE SET unchanged; HAS_STORY and DEPENDS_ON MATCHes use three-property filters", "the seed header comment includes the project line"], s.taskRefs = ["1.2 Thread `project` through `cmd-generate` into `write-seed`; update the seed header comment to include the project line", "1.3 Update `write-seed` to emit project-scoped statements: `MERGE (p:Project {name: <project>});`, `MERGE (c:Change {name: <change>, project: <project>});`, literal `MATCH (p:Project ...), (c:Change ...) MERGE (p)-[:BELONGS_TO]->(c);`, `Story` nodes as `{id, change, project}` with `ON CREATE SET` unchanged, `HAS_STORY` and `DEPENDS_ON` MATCHes with three-property filters"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "project-scoped-seed", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "regenerate-seed-goldens", change: "project-classification"})
ON CREATE SET s.title = "Regenerate seed goldens with --project", s.description = "WHAT: Regenerate scripts/test/fixtures/golden/story-seed.cypher from the new generate output and update the generate-parity tests to invoke --project.\nFILES:\n  - modify: scripts/test/fixtures/golden/story-seed.cypher (regenerated)\n  - modify: scripts/test_story_driver.clj (generate-golden-parity test)\nEDGE CASES:\n  - use project name fixture-project when invoking generate in tests\n  - stories.md output is unchanged by the --project change; confirm the golden stories.md still matches (do not regenerate it)\n  - fixture change-root stories.yaml/tasks.md stay as-is\nCONTEXT: design.md D3; scripts/test_story_driver.clj existing golden tests; scripts/test/fixtures/change-root and golden dirs.", s.acceptanceCriteria = ["golden story-seed.cypher is regenerated via `generate fixture-change --project fixture-project` and contains project-scoped statements", "generate-parity tests invoke --project and compare byte-for-byte against the updated golden", "golden stories.md is unchanged and still matches"], s.taskRefs = ["2.1 Regenerate `scripts/test/fixtures/golden/story-seed.cypher` from the new `generate --project fixture-project` output (and `stories.md` if unchanged confirm it); keep the fixture change-root stories.yaml/tasks.md as-is", "2.2 Update `scripts/test_story_driver.clj` generate-parity tests to invoke `--project` and compare against the updated goldens"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "regenerate-seed-goldens", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "parser-and-seed-shape-tests", change: "project-classification"})
ON CREATE SET s.title = "Test --project parsing and seed shape", s.description = "WHAT: Add parser and seed-shape tests to scripts/test_story_driver.clj covering the new --project behavior.\nFILES:\n  - modify: scripts/test_story_driver.clj (parser-rejection deftest, new seed-shape deftest)\nEDGE CASES:\n  - generate without --project → exit 2, stderr contains \"the following arguments are required: --project\"\n  - --project with no value → exit 2, \"expected one argument\"\n  - --project --root <path> (flag as value) → exit 2, \"expected one argument\"\n  - --project on parse-tasks, sync-tasks, append-state → exit 2, \"unrecognized arguments: --project\"\n  - seed-shape test asserts the emitted cypher contains Project {name}, Change {name, project}, Story {id, change, project}, BELONGS_TO, and three-property HAS_STORY/DEPENDS_ON statements\nCONTEXT: design.md D3; existing parser-rejection deftest patterns in scripts/test_story_driver.clj.", s.acceptanceCriteria = ["parser tests cover missing --project, missing value, flag-as-value, and --project on wrong subcommands — all exit 2 with the specified stderr text", "a seed-shape test asserts Project/Change/Story identity properties, BELONGS_TO, and three-property HAS_STORY/DEPENDS_ON statements in the generated cypher", "all new tests pass under `bb scripts/test_story_driver.clj`"], s.taskRefs = ["2.3 Add parser tests: `generate` without `--project` exits 2 with the required-flag message; `--project` with no value exits 2 with expected-one-argument; `--project --root <path>` (flag as value) exits 2 with expected-one-argument; `--project` on parse-tasks/sync-tasks/append-state is rejected (exit 2)", "2.4 Add a seed-shape test asserting the emitted cypher contains `Project {name}`, `Change {name, project}`, `Story {id, change, project}`, `BELONGS_TO`, and three-property `HAS_STORY`/`DEPENDS_ON` statements"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "parser-and-seed-shape-tests", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "skill-classify-project-docs", change: "project-classification"})
ON CREATE SET s.title = "Document project classification in the skill", s.description = "WHAT: Update skills/openspec-story-driver/SKILL.md: add --project to generate invocations and add a \"Classify the project\" step per design D1/D4.\nFILES:\n  - modify: skills/openspec-story-driver/SKILL.md\nEDGE CASES:\n  - classification Cypher uses MERGE (p:Project {name: ...}) SET p.repoUrl = ..., p.techStack = [...], p.type = ... with full-overwrite semantics: values no longer derivable are written as null to clear them\n  - D1 derivation documented: git origin → lowercase host/owner/repo preserving subgroups; strip scheme/userinfo/port/.git/query/fragment; local/<repo-dir> fallback when origin absent or unparseable; canonical across clones\n  - D4 facts documented: type ∈ {tooling, agent, docs}; techStack lowercase/deduplicated/sorted with aliases (js→javascript, ts→typescript, py→python); repoUrl sanitized (strip userinfo/query/fragment, SSH→HTTPS on known forges, else omit)\nCONTEXT: design.md D1/D4; specs/story-graph/spec.md classification requirement.", s.acceptanceCriteria = ["every generate invocation in SKILL.md passes --project <name>", "a 'Classify the project' step documents D1 name derivation (origin forms, subgroup preservation, local fallback) and D4 facts (type vocabulary, techStack normalization, repoUrl sanitization)", "the classification Cypher shows full-overwrite SET semantics with null-clearing for un-derivable values"], s.taskRefs = ["3.1 Update `skills/openspec-story-driver/SKILL.md`: `generate` invocations gain `--project <name>`; add a \"Classify the project\" step documenting D1 name derivation (git origin → host/owner/repo, subgroup preservation, local fallback, canonical across clones), D4 facts (type vocabulary, techStack normalization, repoUrl sanitization) and the classification Cypher with full-overwrite semantics (`MERGE (p:Project {name}) SET p.repoUrl = ..., p.techStack = [...], p.type = ...;` where values no longer derivable are written as `null` to clear them)"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "skill-classify-project-docs", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "skill-project-scoped-queries", change: "project-classification"})
ON CREATE SET s.title = "Make skill Cypher snippets project-scoped", s.description = "WHAT: Update every Cypher snippet in skills/openspec-story-driver/SKILL.md so Change/Story matches are project-scoped per design D5.\nFILES:\n  - modify: skills/openspec-story-driver/SKILL.md\nEDGE CASES:\n  - seeding/resume guard matches (c:Change {name: ..., project: ...})-[:HAS_STORY]->(s:Story {project: ...})\n  - next-runnable poll filters on change + project and DEPENDS_ON targets within the same change/project\n  - status transitions use MATCH (s:Story {id: ..., change: ..., project: ...})\n  - blocked/completion checks and the graph-schema reference section include the project property\n  - no snippet matches Change or Story without a project filter\nCONTEXT: design.md D5; specs/story-graph + story-execution deltas; current snippets in SKILL.md.", s.acceptanceCriteria = ["the seeding/resume guard, next-runnable poll, status transitions, blocked/completion checks, and graph-schema reference all filter Change/Story by project", "no Cypher snippet in SKILL.md matches Change or Story without a project property"], s.taskRefs = ["3.2 Update every Cypher snippet in the SKILL.md to be project-scoped: seeding/resume guard, next-runnable poll, status transitions (`{id, change, project}`), blocked/completion checks, and the graph-schema reference section"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "skill-project-scoped-queries", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

