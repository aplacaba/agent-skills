ON CREATE SET s.title = "Update opsx-story command and AGENTS.md", s.description = "WHAT: Update commands/opsx-story.md and AGENTS.md for the --project flag and classification flow.\nFILES:\n  - modify: commands/opsx-story.md\n  - modify: AGENTS.md\nEDGE CASES:\n  - opsx-story generate step derives the canonical project name from the repository's git origin per the story-graph classification contract (accepted URL forms, normalization, subgroup preservation, local/<dir> fallback) and passes it as --project\n  - opsx-story workflow summary mentions project classification\n  - AGENTS.md story-driver invocation list shows generate with --project: `generate <change> --project <name> [--root <changeRoot>] [--def <stories.yaml>]`\nCONTEXT: specs/harness-adapters/spec.md opsx-story scenario; AGENTS.md Scripts and tests section.", s.acceptanceCriteria = ["opsx-story.md derives the canonical project name from git origin and passes it as --project, and mentions classification in the workflow summary", "AGENTS.md invocation list includes generate <change> --project <name> [--root <changeRoot>] [--def <stories.yaml>]"], s.taskRefs = ["3.3 Update `commands/opsx-story.md`: the generate step derives the canonical project name from the repository's git `origin` per the story-graph classification contract (accepted URL forms, normalization, subgroup preservation, `local/<dir>` fallback) and passes it as `--project`; workflow summary mentions project classification", "3.4 Update `AGENTS.md` story-driver invocation list: `generate <change> --project <name> [--root <changeRoot>] [--def <stories.yaml>]`"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "command-agents-project-updates", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

MERGE (s:Story {id: "full-verification", change: "project-classification"})
ON CREATE SET s.title = "Verify the project-classification implementation", s.description = "WHAT: Run the full verification pass for the change: test suites, manual CLI checks, documentation greps, and optional graph idempotency.\nFILES:\n  - none (verification only; fix any failures in the files they originate from)\nEDGE CASES:\n  - bb scripts/test_story_driver.clj and bb scripts/test_config_merge.clj both pass with non-zero-exit enforcement\n  - generate with --project produces project-scoped seed; generate without --project exits 2 with usage on stderr; generate -h shows --project as required\n  - grep skills/openspec-story-driver/SKILL.md and commands/opsx-story.md: every generate invocation passes --project; classification step documents D1 derivation incl. local fallback, D4 full-overwrite/null-clearing, repoUrl sanitization; every Cypher snippet matches Change/Story with project\n  - if a live graph is available, run the seed twice and confirm no duplicate Project/Change/Story nodes or edges\nCONTEXT: tasks group 4; design D1-D5.", s.acceptanceCriteria = ["both bb test suites pass with zero failures", "manual checks pass: seed with --project has project-scoped statements; without --project exits 2; generate -h shows required --project", "documentation greps pass (all generate invocations pass --project; classification docs cover D1/D4; all Cypher snippets project-scoped)"], s.taskRefs = ["4.1 Run `bb scripts/test_story_driver.clj` and `bb scripts/test_config_merge.clj` — all assertions pass", "4.2 Manual check: run `generate` with `--project`, inspect `story-seed.cypher` for the project-scoped statements; run `generate` without `--project` and confirm exit 2 + usage on stderr; confirm `generate -h` shows `--project` as required", "4.3 Documentation verification: grep `skills/openspec-story-driver/SKILL.md` and `commands/opsx-story.md` — every `generate` invocation passes `--project`; the classification step documents D1 derivation (incl. local fallback), D4 full-overwrite/null-clearing, and repoUrl sanitization; every Cypher snippet in the skill matches `Change`/`Story` with a `project` property", "4.4 If a live graph is available, run the seed twice and confirm idempotency (no duplicate Project/Change/Story nodes or edges)"], s.status = "pending";
MATCH (c:Change {name: "project-classification"}),
      (s:Story {id: "full-verification", change: "project-classification"})
MERGE (c)-[:HAS_STORY]->(s);

